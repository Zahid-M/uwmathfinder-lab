# Copy to .env (which is gitignored) and fill in. Used only by scripts/export.mjs on your computer.
# Supabase → Project Settings → API (or API Keys). The service_role / secret key can read and
# delete everything: never commit it, never paste it into the website or a chat.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
# Fixed forever once the first export has run (it decides the TEST/DEV split).
SPLIT_SEED=uwmf-lab-v1
